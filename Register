<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Register</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, #f9c9d9 0%, #f1a7c1 100%);
      padding: 1.5rem;
      margin: 0;
    }

    main {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    .glass-card {
      background: rgba(255, 240, 245, 0.45);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-radius: 2rem;
      padding: 2.5rem 2rem;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 30px 50px rgba(200, 80, 130, 0.3), 0 0 0 1px rgba(255, 220, 235, 0.6);
      border: 1px solid rgba(255, 230, 240, 0.8);
      transition: transform 0.2s ease;
    }

    .register-title {
      font-size: 2.2rem;
      font-weight: 600;
      color: #a12b5e;
      text-align: center;
      margin-bottom: 2rem;
      letter-spacing: 1px;
      text-shadow: 0 2px 6px rgba(255, 200, 220, 0.7);
    }

    .input-group {
      margin-bottom: 1.4rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .input-group label {
      color: #8a2f55;
      font-size: 0.9rem;
      font-weight: 600;
      letter-spacing: 0.3px;
      margin-left: 0.3rem;
    }

    .input-group input {
      background: rgba(255, 225, 240, 0.7);
      border: 1.5px solid rgba(240, 160, 190, 0.6);
      border-radius: 40px;
      padding: 0.85rem 1.4rem;
      font-size: 1rem;
      color: #5a1e34;
      outline: none;
      transition: all 0.25s;
      box-shadow: inset 0 2px 8px rgba(200, 100, 140, 0.15);
    }

    .input-group input::placeholder {
      color: rgba(160, 80, 110, 0.5);
    }

    .input-group input:focus {
      border-color: #e04a7a;
      background: rgba(255, 235, 245, 0.95);
      box-shadow: 0 0 0 4px rgba(230, 100, 150, 0.25);
    }

    .input-group input.error {
      border-color: #d43f6b;
      background: rgba(255, 210, 220, 0.8);
      box-shadow: 0 0 0 3px rgba(210, 60, 100, 0.2);
    }

    label.error {
      color: #c42a5a;
      font-size: 0.8rem;
      margin-top: 0.2rem;
      margin-left: 0.8rem;
      font-weight: 600;
      letter-spacing: 0.2px;
    }

    .btn-custom {
      width: 100%;
      background: linear-gradient(135deg, #f78ca9 0%, #e05b8b 100%);
      border: none;
      border-radius: 40px;
      padding: 1rem;
      font-size: 1.15rem;
      font-weight: 700;
      color: #fff;
      margin-top: 0.8rem;
      cursor: pointer;
      box-shadow: 0 12px 22px -8px rgba(200, 70, 120, 0.5);
      transition: all 0.2s;
      letter-spacing: 0.5px;
      border: 1px solid rgba(255, 255, 255, 0.5);
      text-shadow: 0 1px 3px rgba(150, 30, 70, 0.3);
    }

    .btn-custom:hover {
      background: linear-gradient(135deg, #ffa0bd 0%, #e870a0 100%);
      transform: scale(1.02);
      box-shadow: 0 18px 30px -8px #c74b7c;
    }

    .btn-custom:active {
      transform: scale(0.98);
    }

    form p {
      text-align: center;
      margin-top: 1.5rem;
      color: #813e5a;
      font-size: 0.95rem;
      font-weight: 500;
    }

    form p a {
      color: #b83067;
      text-decoration: none;
      font-weight: 700;
      border-bottom: 1px dotted rgba(184, 48, 103, 0.5);
      transition: color 0.2s, border-color 0.2s;
    }

    form p a:hover {
      color: #d43f7b;
      border-bottom: 1px solid #d43f7b;
    }

    .input-group .error {
      display: block;
    }

    @media (max-width: 480px) {
      .glass-card {
        padding: 1.8rem 1.2rem;
      }
      .register-title {
        font-size: 1.8rem;
      }
    }
  </style>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.22.1/jquery.validate.min.js"></script>
</head>
<body>
  <main>
    <div class="glass-card">
      <h2 class="register-title">Register</h2>
      <form id="registerForm">
        <div class="input-group user">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" placeholder="e.g. johndoe">
        </div>
        <div class="input-group email">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" placeholder="you@example.com">
        </div>
        <div class="input-group phone">
          <label for="phone">Phone Number</label>
          <input type="tel" id="phone" name="phone" placeholder="1234567890">
        </div>
        <div class="input-group password">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="••••••••">
        </div>
        <div class="input-group password">
          <label for="confirm">Confirm Password</label>
          <input type="password" id="confirm" name="confirm" placeholder="••••••••">
        </div>
        <button type="submit" class="btn-custom">Register</button>
        <p>Already have an account? <a href="login.html">Login here</a></p>
      </form>
    </div>
  </main>

  <script>
    $(document).ready(function() {
      // Custom validation methods
      $.validator.addMethod("noNumbers", function(value) {
        return !/\d/.test(value);
      }, "Username cannot contain numbers");

      $.validator.addMethod("notAllUpper", function(value) {
        if (!value) return true;
        return value !== value.toUpperCase();
      }, "Username cannot be all uppercase");

      $("#registerForm").validate({
        rules: {
          username: { 
            required: true, 
            minlength: 3, 
            noNumbers: true, 
            notAllUpper: true 
          },
          email: { 
            required: true, 
            email: true 
          },
          phone: { 
            required: true, 
            digits: true, 
            minlength: 10, 
            maxlength: 15 
          },
          password: { 
            required: true, 
            minlength: 5 
          },
          confirm: { 
            required: true, 
            equalTo: "#password" 
          }
        },
        messages: {
          username: {
            required: "Please enter a username",
            minlength: function(p, el) { 
              return "You entered " + el.value.length + " characters, minimum is " + p; 
            }
          },
          email: { 
            required: "Please enter your email", 
            email: "Please enter a valid email address" 
          },
          phone: {
            required: "Please enter your phone number",
            digits: "Only numbers are allowed",
            minlength: function(p, el) { 
              return "You entered " + el.value.length + " digits, minimum is " + p; 
            },
            maxlength: function(p, el) { 
              return "You entered " + el.value.length + " digits, maximum allowed is " + p; 
            }
          },
          password: {
            required: "Please provide a password",
            minlength: function(p, el) { 
              return "You entered " + el.value.length + " characters, minimum is " + p; 
            }
          },
          confirm: { 
            required: "Please confirm your password", 
            equalTo: "Passwords do not match" 
          }
        },
        onkeyup: function(el) { $(el).valid(); },
        onfocusout: function(el) { $(el).valid(); },
        submitHandler: function(form) {
          window.location.href = "registered-successful.html";
        },
        errorElement: "label",
        errorClass: "error",
        errorPlacement: function(error, element) {
          error.insertAfter(element);
        },
        highlight: function(element, errorClass, validClass) {
          $(element).addClass(errorClass).removeClass(validClass);
        },
        unhighlight: function(element, errorClass, validClass) {
          $(element).removeClass(errorClass).addClass(validClass);
        },
        ignore: []
      });
    });
  </script>
</body>
</html>
